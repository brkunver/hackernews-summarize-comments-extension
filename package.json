{
  "name": "hackernews-summarize-comments",
  "description": "Summarize hackernews comments using AI",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "resize": "pnpm dlx @kunver/resize@latest",
    "zip": "wxt zip",
    "zip:all": "pnpm run zip && pnpm run zip:firefox",
    "zip:firefox": "wxt zip -b firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "manager": "node manager.cjs pnpm"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.8.1",
    "typescript": "^5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "pnpm": ">=10.10.0"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^2.0.49",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/groq": "^3.0.38",
    "ai": "^6.0.174",
    "snarkdown": "^2.0.0"
  }
}
